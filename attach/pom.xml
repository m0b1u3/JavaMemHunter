<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.memhunter</groupId>
        <artifactId>memhunter-parent</artifactId>
        <version>0.1.0</version>
    </parent>
    <artifactId>memhunter-attach</artifactId>
    <name>memhunter-attach</name>
    <description>CLI launcher that attaches the JavaMemHunter agent to a target JVM.</description>

    <properties>
        <!--
          Emit Java 8 bytecode so a single attach.jar can attach to JDK 8 target JVMs
          (the dominant production Tomcat runtime). We use source/target 8 instead of the
          release flag on purpose: the release flag restricts the API to the Java 8 standard
          surface, which hides com.sun.tools.attach (it lives in tools.jar on JDK 8 and in
          the jdk.attach module on JDK 9+). source/target keeps the JDK 17 jdk.attach module
          visible at compile time while still producing 8-compatible bytecode.

          Runtime note: when running this jar ON a JDK 8 runtime, put tools.jar on the
          classpath: java -cp "$JAVA_HOME/lib/tools.jar;attach.jar" com.memhunter.attach.AttachMain
          On JDK 9+ runtimes the jdk.attach module is present automatically.
        -->
        <maven.compiler.release></maven.compiler.release>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.memhunter</groupId>
            <artifactId>memhunter-agent</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>memhunter-attach</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.memhunter.attach.AttachMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.memhunter.attach.AttachMain</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
